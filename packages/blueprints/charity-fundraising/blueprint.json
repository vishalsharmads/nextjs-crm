{
  "$schema": "../schema.json",
  "key": "charity-fundraising",
  "name": "Charity fundraising agencies",
  "version": "1.0.0",
  "description": "Charity clients, fundraising campaigns and supporters for face-to-face and telephone fundraising agencies, from pitch to live campaign, welcome calls, quality checks and retention.",
  "settings": {
    "features": {
      "leads": true
    },
    "general": {
      "currency": "GBP"
    },
    "contacts": {
      "sources": [
        "Door to door",
        "Street",
        "Private site",
        "Event",
        "Telephone",
        "Digital",
        "Referral",
        "Other"
      ],
      "lifecycleStatuses": [
        "New sign-up",
        "Welcomed",
        "Active supporter",
        "At risk",
        "Cancelled",
        "Charity contact"
      ]
    },
    "deals": {
      "lostReasons": [
        "Chose another agency",
        "Budget cut",
        "Moved fundraising in-house",
        "Channel paused",
        "Compliance concerns",
        "No response"
      ]
    }
  },
  "vocabulary": {
    "contact": {
      "singular": "Supporter",
      "plural": "Supporters"
    },
    "organization": {
      "singular": "Charity",
      "plural": "Charities"
    },
    "deal": {
      "singular": "Campaign",
      "plural": "Campaigns"
    }
  },
  "modules": [],
  "objects": [
    {
      "key": "shift",
      "singular": "Fundraising shift",
      "plural": "Fundraising shifts",
      "icon": "calendar",
      "description": "A team’s day in the field or on the phones: where, who and how many sign-ups.",
      "links": ["deal"]
    }
  ],
  "custom_field_groups": {
    "contact": [
      {
        "key": "giving",
        "label": "Giving"
      }
    ],
    "deal": [
      {
        "key": "campaign",
        "label": "Campaign details"
      }
    ],
    "shift": [
      {
        "key": "shift",
        "label": "Shift"
      }
    ]
  },
  "custom_fields": {
    "contact": [
      {
        "key": "signup_channel",
        "label": "Sign-up channel",
        "type": "select",
        "group": "giving",
        "filterable": true,
        "show_in_list": true,
        "options": [
          {
            "key": "door_to_door",
            "label": "Door to door"
          },
          {
            "key": "street",
            "label": "Street"
          },
          {
            "key": "private_site",
            "label": "Private site"
          },
          {
            "key": "event",
            "label": "Event"
          },
          {
            "key": "telephone",
            "label": "Telephone"
          },
          {
            "key": "digital",
            "label": "Digital"
          }
        ]
      },
      {
        "key": "monthly_gift",
        "label": "Monthly gift",
        "type": "currency",
        "group": "giving",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "signup_date",
        "label": "Sign-up date",
        "type": "date",
        "group": "giving",
        "filterable": true
      },
      {
        "key": "welcome_call",
        "label": "Welcome call",
        "type": "select",
        "group": "giving",
        "filterable": true,
        "show_in_list": true,
        "options": [
          {
            "key": "pending",
            "label": "Pending"
          },
          {
            "key": "completed",
            "label": "Completed"
          },
          {
            "key": "no_answer",
            "label": "No answer"
          },
          {
            "key": "declined",
            "label": "Declined"
          }
        ]
      },
      {
        "key": "qc_status",
        "label": "Quality check",
        "type": "select",
        "group": "giving",
        "filterable": true,
        "show_in_list": true,
        "options": [
          {
            "key": "pending",
            "label": "Pending"
          },
          {
            "key": "passed",
            "label": "Passed"
          },
          {
            "key": "failed",
            "label": "Failed"
          }
        ]
      },
      {
        "key": "gift_aid",
        "label": "Gift Aid declared",
        "type": "boolean",
        "group": "giving",
        "filterable": true
      },
      {
        "key": "check_in_due",
        "label": "Check-in call due",
        "type": "date",
        "group": "giving",
        "filterable": true
      }
    ],
    "deal": [
      {
        "key": "channel",
        "label": "Channel",
        "type": "select",
        "group": "campaign",
        "required": true,
        "filterable": true,
        "show_in_list": true,
        "options": [
          {
            "key": "face_to_face",
            "label": "Face to face"
          },
          {
            "key": "telephone",
            "label": "Telephone"
          },
          {
            "key": "digital",
            "label": "Digital"
          },
          {
            "key": "mixed",
            "label": "Mixed"
          }
        ]
      },
      {
        "key": "target_signups",
        "label": "Target sign-ups",
        "type": "number",
        "group": "campaign",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "start_date",
        "label": "Start date",
        "type": "date",
        "group": "campaign",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "end_date",
        "label": "End date",
        "type": "date",
        "group": "campaign",
        "filterable": true
      },
      {
        "key": "retention_target",
        "label": "12-month retention target (%)",
        "type": "decimal",
        "group": "campaign",
        "validation": {
          "min": 0,
          "max": 100,
          "scale": 1
        }
      }
    ],
    "shift": [
      {
        "key": "shift_date",
        "label": "Date",
        "type": "date",
        "group": "shift",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "location",
        "label": "Location",
        "type": "text",
        "group": "shift",
        "show_in_list": true
      },
      {
        "key": "fundraisers",
        "label": "Fundraisers",
        "type": "number",
        "group": "shift",
        "show_in_list": true
      },
      {
        "key": "signups",
        "label": "Sign-ups",
        "type": "number",
        "group": "shift",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "average_gift",
        "label": "Average gift",
        "type": "currency",
        "group": "shift",
        "show_in_list": true
      }
    ]
  },
  "pipelines": [
    {
      "key": "campaigns",
      "name": "Campaigns",
      "entity": "deal",
      "is_default": true,
      "stages": [
        {
          "key": "enquiry",
          "name": "Enquiry",
          "probability": 10,
          "rotting_days": 7
        },
        {
          "key": "pitch",
          "name": "Pitch",
          "probability": 30,
          "rotting_days": 14
        },
        {
          "key": "proposal",
          "name": "Proposal",
          "probability": 50,
          "rotting_days": 14
        },
        {
          "key": "contracting",
          "name": "Contracting",
          "probability": 80,
          "rotting_days": 21
        },
        {
          "key": "live",
          "name": "Live",
          "probability": 100,
          "is_won": true
        },
        {
          "key": "lost",
          "name": "Lost",
          "probability": 0,
          "is_lost": true
        }
      ]
    }
  ],
  "roles": [
    {
      "key": "fundraiser",
      "name": "Fundraiser",
      "description": "Signs up supporters in the field and sees only their own sign-ups",
      "permissions": [
        "core.contacts.view",
        "core.contacts.create",
        "core.contacts.update",
        "core.organizations.view",
        "core.deals.view",
        "core.activities.*",
        "core.tags.view",
        "core.dashboard.view",
        "custom.shift.view"
      ],
      "scopes": {
        "core.contacts": "own",
        "core.activities": "own",
        "core.deals": "all",
        "core.organizations": "all",
        "custom.shift": "all"
      }
    },
    {
      "key": "supporter_care",
      "name": "Supporter care",
      "description": "Makes welcome, quality-check and check-in calls to every supporter",
      "permissions": [
        "core.contacts.*",
        "core.organizations.view",
        "core.deals.view",
        "core.activities.*",
        "core.tags.*",
        "core.files.*",
        "core.dashboard.view",
        "core.saved_views.share",
        "custom.shift.*"
      ],
      "scopes": {
        "*": "all"
      }
    },
    {
      "key": "account_manager",
      "name": "Account manager",
      "description": "Wins and runs charity campaigns, from pitch to live reporting",
      "permissions": [
        "core.contacts.view",
        "core.organizations.*",
        "core.leads.*",
        "core.deals.*",
        "core.activities.*",
        "core.tags.*",
        "core.files.*",
        "core.dashboard.view",
        "core.saved_views.share",
        "custom.shift.*"
      ],
      "scopes": {
        "*": "all"
      }
    }
  ],
  "layouts": [
    {
      "entity": "contact",
      "context": "list",
      "columns": [
        "full_name",
        "organization",
        "lifecycle_status",
        "cf.signup_channel",
        "cf.monthly_gift",
        "cf.welcome_call",
        "cf.qc_status",
        "owner"
      ]
    },
    {
      "entity": "deal",
      "context": "list",
      "columns": [
        "title",
        "organization",
        "stage",
        "value",
        "cf.channel",
        "cf.target_signups",
        "cf.start_date",
        "owner"
      ]
    }
  ],
  "dashboard": {
    "name": "Overview",
    "widgets": [
      {
        "key": "pipeline_value",
        "type": "pipeline_value",
        "title": "Campaigns by stage",
        "size": "lg",
        "params": {
          "pipeline": "campaigns"
        }
      },
      {
        "key": "starts",
        "type": "date_window",
        "title": "Campaigns starting in the next 30 days",
        "size": "md",
        "params": {
          "entity": "deal",
          "field": "cf.start_date",
          "days": 30
        }
      },
      {
        "key": "checkins",
        "type": "date_window",
        "title": "Supporter check-ins due in the next 14 days",
        "size": "md",
        "params": {
          "entity": "contact",
          "field": "cf.check_in_due",
          "days": 14
        }
      },
      {
        "key": "tasks_due",
        "type": "tasks_due",
        "title": "My tasks due",
        "size": "md"
      }
    ]
  },
  "templates": [
    {
      "key": "supporter.welcome",
      "channel": "email",
      "name": "Welcome to new supporter",
      "subject": "Thank you for your support",
      "body": "<p>Hi {{contact.firstName}},</p><p>Thank you for signing up today. Your monthly gift makes a real difference, and we wanted to confirm your details and let you know what happens next.</p><p>One of our team will call you in the next few days to say thank you and answer any questions. If anything looks wrong, just reply to this email.</p>"
    },
    {
      "key": "supporter.check_in",
      "channel": "email",
      "name": "Supporter check-in",
      "subject": "A quick update on your impact",
      "body": "<p>Hi {{contact.firstName}},</p><p>It has been a few months since you started giving, and we wanted to share what your support has helped achieve so far.</p><p>If you would like to change your gift or how we keep in touch, reply to this email and we will sort it out.</p>"
    },
    {
      "key": "charity.campaign_report",
      "channel": "email",
      "name": "Weekly campaign report",
      "subject": "Your weekly campaign report",
      "body": "<p>Hi {{contact.firstName}},</p><p>Here is this week’s summary for your campaign: sign-ups, average gift, quality-check pass rate and welcome-call reach. Your full breakdown is attached.</p><p>Happy to talk through any of it on our next call.</p>"
    }
  ],
