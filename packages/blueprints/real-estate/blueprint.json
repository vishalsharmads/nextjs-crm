{
  "$schema": "../schema.json",
  "key": "real-estate",
  "name": "Real estate agency",
  "version": "1.0.0",
  "description": "Buyers, vendors and listings from appraisal to settlement, with open homes, agency agreements, vendor portal access and commission invoices.",
  "settings": {
    "features": {
      "leads": true
    },
    "general": {
      "currency": "AUD"
    },
    "contacts": {
      "sources": [
        "Open home",
        "Property portal",
        "Website",
        "Signboard",
        "Referral",
        "Past client",
        "Social",
        "Other"
      ],
      "lifecycleStatuses": ["Prospective buyer", "Active buyer", "Vendor", "Past client"]
    },
    "deals": {
      "lostReasons": [
        "Listed with another agency",
        "Price expectations",
        "Vendor withdrew",
        "Passed in, not sold",
        "No response"
      ]
    }
  },
  "vocabulary": {
    "contact": {
      "singular": "Buyer",
      "plural": "Buyers"
    },
    "organization": {
      "singular": "Agency",
      "plural": "Agencies"
    },
    "deal": {
      "singular": "Listing",
      "plural": "Listings"
    }
  },
  "modules": ["bookings", "portal", "documents", "invoices"],
  "custom_field_groups": {
    "contact": [
      {
        "key": "buying",
        "label": "Buying profile"
      }
    ],
    "deal": [
      {
        "key": "property",
        "label": "Property"
      },
      {
        "key": "campaign",
        "label": "Campaign"
      }
    ]
  },
  "custom_fields": {
    "contact": [
      {
        "key": "buyer_type",
        "label": "Buyer type",
        "type": "select",
        "group": "buying",
        "filterable": true,
        "show_in_list": true,
        "options": [
          {
            "key": "first_home",
            "label": "First home buyer"
          },
          {
            "key": "owner_occupier",
            "label": "Owner-occupier"
          },
          {
            "key": "investor",
            "label": "Investor"
          },
          {
            "key": "downsizer",
            "label": "Downsizer"
          }
        ]
      },
      {
        "key": "max_budget",
        "label": "Max budget",
        "type": "currency",
        "group": "buying",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "finance_status",
        "label": "Finance",
        "type": "select",
        "group": "buying",
        "filterable": true,
        "options": [
          {
            "key": "pre_approved",
            "label": "Pre-approved"
          },
          {
            "key": "arranging",
            "label": "Arranging finance"
          },
          {
            "key": "cash",
            "label": "Cash buyer"
          },
          {
            "key": "not_started",
            "label": "Not started"
          }
        ]
      }
    ],
    "deal": [
      {
        "key": "property_type",
        "label": "Property type",
        "type": "select",
        "group": "property",
        "filterable": true,
        "show_in_list": true,
        "options": [
          {
            "key": "house",
            "label": "House"
          },
          {
            "key": "apartment",
            "label": "Apartment"
          },
          {
            "key": "townhouse",
            "label": "Townhouse"
          },
          {
            "key": "land",
            "label": "Land"
          }
        ]
      },
      {
        "key": "bedrooms",
        "label": "Bedrooms",
        "type": "number",
        "group": "property",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "sale_method",
        "label": "Sale method",
        "type": "select",
        "group": "campaign",
        "filterable": true,
        "options": [
          {
            "key": "private_treaty",
            "label": "Private treaty"
          },
          {
            "key": "auction",
            "label": "Auction"
          },
          {
            "key": "eoi",
            "label": "Expressions of interest"
          }
        ]
      },
      {
        "key": "settlement_date",
        "label": "Settlement date",
        "type": "date",
        "group": "campaign",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "commission_rate",
        "label": "Commission rate (%)",
        "type": "decimal",
        "group": "campaign",
        "visibility": {
          "default": "write",
          "roles": {
            "sales_agent": "read"
          }
        }
      }
    ]
  },
  "pipelines": [
    {
      "key": "listings",
      "name": "Listings",
      "entity": "deal",
      "is_default": true,
      "stages": [
        {
          "key": "appraisal",
          "name": "Appraisal",
          "probability": 20,
          "rotting_days": 14
        },
        {
          "key": "listed",
          "name": "Listed",
          "probability": 40,
          "rotting_days": 21
        },
        {
          "key": "open_homes",
          "name": "Open homes",
          "probability": 60,
          "rotting_days": 28
        },
        {
          "key": "under_offer",
          "name": "Under offer",
          "probability": 85,
          "rotting_days": 10
        },
        {
          "key": "settled",
          "name": "Settled",
          "probability": 100,
          "is_won": true
        },
        {
          "key": "withdrawn",
          "name": "Withdrawn",
          "probability": 0,
          "is_lost": true
        }
      ]
    }
  ],
  "roles": [
    {
      "key": "sales_agent",
      "name": "Sales agent",
      "description": "Runs their own appraisals, listings, open homes and buyer follow-up",
      "permissions": [
        "core.contacts.*",
        "core.organizations.view",
        "core.leads.*",
        "core.deals.*",
        "core.activities.*",
        "core.tags.*",
        "core.files.*",
        "core.dashboard.*",
        "bookings.bookings.*",
        "documents.documents.*",
        "invoices.invoices.view"
      ],
      "scopes": {
        "*": "own",
        "core.contacts": "all",
        "bookings.bookings": "all"
      }
    },
    {
      "key": "office_admin",
      "name": "Office administrator",
      "description": "Manages every listing, open-home schedule, agency agreement and invoice",
      "permissions": [
        "core.contacts.*",
        "core.organizations.*",
        "core.leads.*",
        "core.deals.*",
        "core.activities.*",
        "core.tags.*",
        "core.files.*",
        "core.dashboard.*",
        "core.saved_views.share",
        "bookings.*",
        "documents.*",
        "invoices.*",
        "products.products.*",
        "portal.accounts.manage"
      ],
      "scopes": {
        "*": "all"
      }
    }
  ],
  "layouts": [
    {
      "entity": "contact",
      "context": "list",
      "columns": [
        "full_name",
        "email",
        "phone",
        "lifecycle_status",
        "cf.buyer_type",
        "cf.max_budget",
        "owner"
      ]
    },
    {
      "entity": "deal",
      "context": "list",
      "columns": [
        "title",
        "contact",
        "stage",
        "value",
        "cf.property_type",
        "cf.bedrooms",
        "cf.settlement_date",
        "owner"
      ]
    }
  ],
  "dashboard": {
    "name": "Overview",
    "widgets": [
      {
        "key": "pipeline_value",
        "type": "pipeline_value",
        "title": "Listings by stage",
        "size": "lg",
        "params": {
          "pipeline": "listings"
        }
      },
      {
        "key": "settlements",
        "type": "date_window",
        "title": "Settlements in the next 45 days",
        "size": "md",
        "params": {
          "entity": "deal",
          "field": "cf.settlement_date",
          "days": 45,
          "status": "open"
        }
      },
      {
        "key": "documents",
        "type": "module:documents.awaiting",
        "title": "Agreements and files awaiting action",
        "size": "md"
      },
      {
        "key": "receivables",
        "type": "module:invoices.receivables",
        "title": "Outstanding invoices",
        "size": "sm"
      },
      {
        "key": "conversion",
        "type": "conversion",
        "title": "Listings sold (180 days)",
        "size": "sm",
        "params": {
          "days": 180
        }
      },
      {
        "key": "tasks_due",
        "type": "tasks_due",
        "title": "My tasks due",
        "size": "md"
      }
    ]
  },
  "templates": [],
