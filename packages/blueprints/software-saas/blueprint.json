{
  "$schema": "../schema.json",
  "key": "software-saas",
  "name": "Software and SaaS companies",
  "version": "1.0.0",
  "description": "Inbound leads, accounts, opportunities, subscriptions, support tickets and feature requests for software and SaaS companies, from first sign-up to renewal.",
  "settings": {
    "features": {
      "leads": true,
      "leadPipeline": true
    },
    "general": {
      "currency": "USD"
    },
    "contacts": {
      "sources": [
        "Website",
        "Free trial",
        "Webinar",
        "Content download",
        "Partner",
        "Outbound",
        "Event",
        "Referral",
        "Other"
      ],
      "lifecycleStatuses": ["Prospect", "Trial user", "Customer", "Champion", "Churned", "Partner"]
    },
    "deals": {
      "lostReasons": [
        "Chose a competitor",
        "No budget",
        "Missing feature",
        "Built in-house",
        "Timing",
        "Security review failed",
        "No response"
      ]
    }
  },
  "vocabulary": {
    "organization": {
      "singular": "Account",
      "plural": "Accounts"
    },
    "deal": {
      "singular": "Opportunity",
      "plural": "Opportunities"
    }
  },
  "modules": [],
  "objects": [
    {
      "key": "subscription",
      "singular": "Subscription",
      "plural": "Subscriptions",
      "icon": "credit-card",
      "description": "Plans an account pays for: seats, recurring revenue and renewal date.",
      "links": ["organization", "deal"]
    },
    {
      "key": "support_ticket",
      "singular": "Support ticket",
      "plural": "Support tickets",
      "icon": "life-buoy",
      "description": "Customer issues, their priority and where they stand.",
      "links": ["organization", "contact"]
    },
    {
      "key": "feature_request",
      "singular": "Feature request",
      "plural": "Feature requests",
      "icon": "clipboard-list",
      "description": "Product ideas from customers and prospects, with the revenue asking for them.",
      "links": ["organization"]
    }
  ],
  "custom_field_groups": {
    "organization": [
