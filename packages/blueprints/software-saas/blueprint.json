  "pipelines": [
    {
      "key": "sales",
      "name": "Sales",
      "entity": "deal",
      "is_default": true,
      "stages": [
        {
          "key": "discovery",
          "name": "Discovery",
          "probability": 10,
          "color": "blue",
          "rotting_days": 10
        },
        {
          "key": "demo",
          "name": "Demo",
          "probability": 25,
          "color": "teal",
          "rotting_days": 10
        },
        {
          "key": "trial",
          "name": "Trial / proof of concept",
          "probability": 40,
          "color": "violet",
          "rotting_days": 21
        },
        {
          "key": "proposal",
          "name": "Proposal",
          "probability": 60,
          "color": "amber",
          "rotting_days": 14
        },
        {
          "key": "negotiation",
          "name": "Negotiation and security review",
          "probability": 80,
          "color": "orange",
          "rotting_days": 21
        },
        {
          "key": "won",
          "name": "Closed won",
          "probability": 100,
          "color": "green",
          "is_won": true
        },
        {
          "key": "lost",
          "name": "Closed lost",
          "probability": 0,
          "color": "red",
          "is_lost": true
        }
      ]
    },
    {
      "key": "lead_qualification",
      "name": "Lead qualification",
      "entity": "lead",
      "is_default": true,
      "stages": [
        {
          "key": "new",
          "name": "New",
          "color": "blue",
          "rotting_days": 2
        },
        {
          "key": "engaged",
          "name": "Engaged",
          "color": "teal",
          "rotting_days": 7
        },
        {
          "key": "mql",
          "name": "Marketing qualified",
          "color": "violet",
          "rotting_days": 5
        },
        {
          "key": "meeting",
          "name": "Meeting booked",
          "color": "amber",
          "rotting_days": 7
        },
        {
          "key": "sql",
          "name": "Sales qualified",
          "color": "green",
          "is_won": true
        },
        {
          "key": "disqualified",
          "name": "Disqualified",
          "color": "red",
          "is_lost": true
        }
      ]
    }
  ],
  "roles": [
    {
      "key": "sdr",
      "name": "Sales development rep",
      "description": "Works inbound and outbound leads and books meetings for account executives",
      "permissions": [
        "core.leads.*",
        "core.contacts.view",
        "core.contacts.create",
        "core.contacts.update",
        "core.organizations.view",
        "core.organizations.create",
        "core.deals.view",
        "core.activities.*",
        "core.tags.view",
        "core.dashboard.view"
      ],
      "scopes": {
        "core.leads": "own",
        "core.activities": "own",
        "core.contacts": "all",
        "core.organizations": "all",
        "core.deals": "all"
      }
    },
    {
      "key": "account_executive",
      "name": "Account executive",
      "description": "Runs their own opportunities from discovery to signature",
      "permissions": [
        "core.contacts.*",
        "core.organizations.*",
        "core.leads.view",
        "core.deals.*",
        "core.activities.*",
        "core.tags.*",
        "core.files.*",
        "core.dashboard.view",
        "custom.subscription.view",
        "custom.feature_request.*",
        "custom.support_ticket.view"
      ],
      "scopes": {
        "core.deals": "own",
        "core.activities": "own",
        "core.contacts": "all",
        "core.organizations": "all",
        "core.leads": "all",
        "custom.subscription": "all",
        "custom.feature_request": "all",
        "custom.support_ticket": "all"
      }
    },
    {
      "key": "customer_success",
      "name": "Customer success",
      "description": "Owns onboarding, renewals, support escalations and account health",
      "permissions": [
        "core.contacts.*",
        "core.organizations.*",
        "core.deals.view",
        "core.deals.create",
        "core.deals.update",
        "core.activities.*",
        "core.tags.*",
        "core.files.*",
        "core.dashboard.view",
        "core.saved_views.share",
        "custom.subscription.*",
        "custom.support_ticket.*",
        "custom.feature_request.*"
      ],
      "scopes": {
        "*": "all"
      }
    }
  ],
  "layouts": [
    {
      "entity": "lead",
      "context": "list",
      "columns": [
        "full_name",
        "company_name",
        "stage",
        "cf.lead_score",
        "cf.trial_started",
        "source",
        "owner"
      ]
    },
    {
      "entity": "organization",
      "context": "list",
      "columns": ["name", "cf.tier", "cf.company_size", "cf.health", "owner"]
    },
    {
      "entity": "deal",
      "context": "list",
      "columns": [
        "title",
        "organization",
        "stage",
        "value",
        "cf.deal_type",
        "cf.plan",
        "cf.close_date",
        "owner"
      ]
    }
  ],
  "dashboard": {
    "name": "Overview",
    "widgets": [
      {
        "key": "pipeline_value",
        "type": "pipeline_value",
        "title": "Opportunities by stage",
        "size": "lg",
        "params": {
          "pipeline": "sales"
        }
      },
      {
        "key": "closing",
        "type": "date_window",
        "title": "Opportunities closing in the next 30 days",
        "size": "md",
        "params": {
          "entity": "deal",
          "field": "cf.close_date",
          "days": 30,
          "status": "open"
        }
      },
      {
        "key": "conversion",
        "type": "conversion",
        "title": "Win rate (90 days)",
        "size": "sm",
        "params": {
          "days": 90
        }
      },
      {
        "key": "tasks_due",
        "type": "tasks_due",
        "title": "My tasks due",
        "size": "md"
      },
      {
        "key": "activity_by_user",
        "type": "activity_by_user",
        "title": "Team activity (30 days)",
        "size": "md",
        "params": {
          "days": 30
        }
      }
    ]
  },
  "templates": [
    {
      "key": "sales.trial_follow_up",
      "channel": "email",
      "name": "Trial follow-up",
      "subject": "How is your trial going?",
      "body": "<p>Hi {{contact.firstName}},</p><p>You are a few days into your trial, so I wanted to check in. Teams that get the most out of it usually connect one integration and invite two colleagues in the first week.</p><p>Want a 20-minute walkthrough tailored to your use case? Reply with a time that suits you.</p>"
    },
    {
      "key": "sales.demo_recap",
      "channel": "email",
      "name": "Demo recap",
      "subject": "Recap and next steps from today’s demo",
      "body": "<p>Hi {{contact.firstName}},</p><p>Thanks for your time today. As promised, here is a summary of what we covered, the questions we still owe you answers on, and the proposed next step.</p><p>Let me know if anyone else on your team should join the next session.</p>"
    },
    {
      "key": "success.renewal_notice",
      "channel": "email",
      "name": "Renewal reminder",
      "subject": "Your subscription renews soon",
      "body": "<p>Hi {{contact.firstName}},</p><p>Your subscription is coming up for renewal. Before then, it is worth a short review of seats, usage and anything on your roadmap we should know about.</p><p>Reply to book a renewal call.</p>"
    }
  ],
  "help": {
    "settings.pipelines": "This workspace has two pipelines: **Sales** for opportunities, and **Lead qualification** for leads, from new sign-up to sales qualified. A lead that reaches *Sales qualified* is ready to convert into a contact, an account and an opportunity."
  },
