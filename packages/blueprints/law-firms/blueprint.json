{
  "$schema": "../schema.json",
  "key": "law-firms",
  "name": "Law firm",
  "version": "1.0.0",
  "description": "Clients and matters from intake and conflict check to engagement and close, with engagement letters, client file requests, fee estimates, invoices and client questions.",
  "settings": {
    "features": {
      "leads": true
    },
    "general": {
      "currency": "USD"
    },
    "contacts": {
      "sources": [
        "Web form",
        "Phone",
        "Referral",
        "Bar referral",
        "Past client",
        "Directory",
        "Event",
        "Other"
      ],
      "lifecycleStatuses": ["Prospective client", "Client", "Former client"]
    },
    "deals": {
      "lostReasons": [
        "Conflict of interest",
        "Outside our practice areas",
        "Chose another firm",
        "Fees",
        "No response"
      ]
    }
  },
  "vocabulary": {
    "contact": {
      "singular": "Client",
      "plural": "Clients"
    },
    "organization": {
      "singular": "Company",
      "plural": "Companies"
    },
    "deal": {
      "singular": "Matter",
      "plural": "Matters"
    }
  },
  "modules": ["documents", "portal", "quotes", "invoices", "tickets"],
  "custom_field_groups": {
    "contact": [
      {
        "key": "intake",
        "label": "Intake"
      }
    ],
    "deal": [
      {
        "key": "matter",
        "label": "Matter details"
      }
    ]
  },
  "custom_fields": {
    "contact": [
      {
        "key": "client_type",
        "label": "Client type",
        "type": "select",
        "group": "intake",
        "filterable": true,
        "show_in_list": true,
        "options": [
          {
            "key": "individual",
            "label": "Individual"
          },
          {
            "key": "business",
            "label": "Business"
          }
        ]
      },
      {
        "key": "id_verified",
        "label": "ID verified",
        "type": "boolean",
        "group": "intake",
        "filterable": true,
        "show_in_list": true
      }
    ],
    "deal": [
      {
        "key": "practice_area",
        "label": "Practice area",
        "type": "select",
        "group": "matter",
        "required": true,
        "filterable": true,
        "show_in_list": true,
        "options": [
          {
            "key": "family",
            "label": "Family"
          },
          {
            "key": "estate_planning",
            "label": "Wills and estates"
          },
          {
            "key": "real_estate",
            "label": "Real estate"
          },
          {
            "key": "commercial",
            "label": "Commercial"
          },
          {
            "key": "employment",
            "label": "Employment"
          },
          {
            "key": "litigation",
            "label": "Litigation"
          },
          {
            "key": "immigration",
            "label": "Immigration"
          }
        ]
      },
      {
        "key": "fee_arrangement",
        "label": "Fee arrangement",
        "type": "select",
        "group": "matter",
        "filterable": true,
        "options": [
          {
            "key": "hourly",
            "label": "Hourly"
          },
          {
            "key": "fixed_fee",
            "label": "Fixed fee"
          },
          {
            "key": "retainer",
            "label": "Retainer"
          },
          {
            "key": "contingency",
            "label": "Contingency"
          }
        ]
      },
      {
        "key": "conflict_cleared",
        "label": "Conflict cleared",
        "type": "boolean",
        "group": "matter",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "opposing_party",
        "label": "Opposing party",
        "type": "text",
        "group": "matter",
        "filterable": true
      },
      {
        "key": "next_key_date",
        "label": "Next key date",
        "type": "date",
        "group": "matter",
        "filterable": true,
        "show_in_list": true,
        "help_text": "Next hearing, filing deadline or closing date"
      }
    ]
  },
  "pipelines": [
    {
      "key": "matters",
      "name": "Matters",
      "entity": "deal",
      "is_default": true,
      "stages": [
        {
          "key": "intake",
          "name": "Intake",
          "probability": 10,
          "rotting_days": 3
        },
        {
          "key": "conflict_check",
          "name": "Conflict check",
          "probability": 30,
          "rotting_days": 2
        },
        {
          "key": "engaged",
          "name": "Engaged",
          "probability": 80,
          "rotting_days": 14
        },
        {
          "key": "in_progress",
          "name": "In progress",
          "probability": 90,
          "rotting_days": 30
        },
        {
          "key": "closed",
          "name": "Closed",
          "probability": 100,
          "is_won": true
        },
        {
          "key": "declined",
          "name": "Declined",
          "probability": 0,
          "is_lost": true
        }
      ]
    }
  ],
  "roles": [
    {
      "key": "attorney",
      "name": "Attorney",
      "description": "Runs their own clients and matters, sends fee estimates and engagement letters",
      "permissions": [
        "core.contacts.*",
        "core.organizations.*",
        "core.leads.*",
        "core.deals.*",
        "core.activities.*",
        "core.tags.*",
        "core.files.*",
        "core.dashboard.*",
        "documents.documents.*",
        "quotes.quotes.*",
        "invoices.invoices.view",
        "invoices.invoices.create",
        "tickets.tickets.*"
      ],
      "scopes": {
        "*": "own",
        "core.organizations": "all"
      }
    },
    {
      "key": "paralegal",
      "name": "Paralegal",
      "description": "Handles intake and conflict checks, collects client files and answers client questions",
      "permissions": [
        "core.contacts.view",
        "core.contacts.create",
        "core.contacts.update",
        "core.organizations.view",
        "core.leads.*",
        "core.deals.view",
        "core.deals.update",
        "core.activities.*",
        "core.tags.*",
        "core.files.*",
        "core.dashboard.view",
        "documents.documents.*",
        "quotes.quotes.view",
        "invoices.invoices.view",
        "tickets.tickets.*",
        "portal.accounts.manage"
      ],
      "scopes": {
        "*": "all",
        "core.activities": "own"
      }
    }
  ],
  "layouts": [
    {
      "entity": "contact",
      "context": "list",
      "columns": [
        "full_name",
        "email",
        "phone",
        "organization",
        "cf.client_type",
        "cf.id_verified",
        "lifecycle_status",
        "owner"
      ]
    },
    {
      "entity": "deal",
      "context": "list",
      "columns": [
        "title",
        "contact",
        "stage",
        "cf.practice_area",
        "cf.conflict_cleared",
        "cf.next_key_date",
        "value",
        "owner"
      ]
    }
  ],
  "dashboard": {
    "name": "Overview",
    "widgets": [
      {
        "key": "pipeline_value",
        "type": "pipeline_value",
        "title": "Matters by stage",
        "size": "lg",
        "params": {
          "pipeline": "matters"
        }
      },
      {
        "key": "key_dates",
        "type": "date_window",
        "title": "Key dates in the next 30 days",
        "size": "md",
        "params": {
          "entity": "deal",
          "field": "cf.next_key_date",
          "days": 30,
          "status": "open"
        }
      },
      {
        "key": "documents",
        "type": "module:documents.awaiting",
        "title": "Letters and files awaiting action",
        "size": "md"
      },
      {
        "key": "receivables",
        "type": "module:invoices.receivables",
        "title": "Outstanding fees",
        "size": "sm"
      },
      {
        "key": "open_tickets",
        "type": "module:tickets.open_count",
        "title": "Open client questions",
        "size": "sm"
      },
      {
        "key": "tasks_due",
        "type": "tasks_due",
        "title": "My tasks due",
        "size": "md"
      }
    ]
  },
  "templates": [],
