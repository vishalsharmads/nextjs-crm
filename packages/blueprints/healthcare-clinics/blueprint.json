{
  "$schema": "../schema.json",
  "key": "healthcare-clinics",
  "name": "Healthcare clinic",
  "version": "1.0.0",
  "description": "Patients, referrers and treatment plans for private dental, physio and skin clinics, from first enquiry to completed treatment and recall.",
  "settings": {
    "features": { "leads": true },
    "general": { "currency": "USD" },
    "contacts": {
      "sources": ["Website", "Phone", "Referral", "Walk-in", "Search", "Social", "Employer program", "Other"],
      "lifecycleStatuses": ["Enquirer", "New patient", "Active patient", "Completed", "Inactive"]
    },
    "deals": {
      "lostReasons": [
        "Cost",
        "Chose another clinic",
        "Timing",
        "Not covered by insurance",
        "Not suitable for treatment",
        "No response"
      ]
    }
  },
  "vocabulary": {
    "contact": { "singular": "Patient", "plural": "Patients" },
    "organization": { "singular": "Referrer", "plural": "Referrers" },
    "deal": { "singular": "Treatment plan", "plural": "Treatment plans" }
  },
  "modules": ["bookings", "quotes", "invoices", "documents", "portal"],
  "custom_field_groups": {
    "contact": [{ "key": "patient", "label": "Patient details" }],
    "deal": [{ "key": "plan", "label": "Plan details" }]
  },
  "custom_fields": {
    "contact": [
      {
        "key": "payment_type",
        "label": "Payment type",
        "type": "select",
        "group": "patient",
        "filterable": true,
        "show_in_list": true,
        "options": [
          { "key": "self_pay", "label": "Self-pay" },
          { "key": "insurance", "label": "Insurance" },
          { "key": "payment_plan", "label": "Payment plan" },
          { "key": "employer", "label": "Employer program" }
        ]
      },
      {
        "key": "intake_complete",
        "label": "Intake forms complete",
        "type": "boolean",
        "group": "patient",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "recall_due",
        "label": "Recall due",
        "type": "date",
        "group": "patient",
        "filterable": true,
        "show_in_list": true
      }
    ],
    "deal": [
      {
        "key": "service_line",
        "label": "Service",
        "type": "select",
        "group": "plan",
        "required": true,
        "filterable": true,
        "show_in_list": true,
        "options": [
          { "key": "general_dental", "label": "General dental" },
          { "key": "implants", "label": "Implants" },
          { "key": "orthodontics", "label": "Orthodontics" },
          { "key": "physiotherapy", "label": "Physiotherapy" },
          { "key": "skin", "label": "Skin" }
        ]
      },
      {
        "key": "practitioner",
        "label": "Practitioner",
        "type": "text",
        "group": "plan",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "sessions_planned",
        "label": "Sessions planned",
        "type": "number",
        "group": "plan",
        "validation": { "min": 1, "max": 60 }
      },
      {
        "key": "next_appointment",
        "label": "Next appointment",
        "type": "date",
        "group": "plan",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "consent_signed",
        "label": "Consent signed",
        "type": "boolean",
        "group": "plan",
        "filterable": true
      }
    ]
  },
  "pipelines": [
    {
      "key": "treatment_plans",
      "name": "Treatment plans",
      "entity": "deal",
      "is_default": true,
      "stages": [
        { "key": "enquiry", "name": "Enquiry", "probability": 10, "rotting_days": 2 },
        { "key": "consult_booked", "name": "Consult booked", "probability": 30, "rotting_days": 10 },
        { "key": "plan_proposed", "name": "Plan proposed", "probability": 55, "rotting_days": 7 },
        { "key": "in_treatment", "name": "In treatment", "probability": 90, "rotting_days": 45 },
        { "key": "completed", "name": "Completed", "probability": 100, "is_won": true },
        { "key": "lost", "name": "Lost", "probability": 0, "is_lost": true }
      ]
    }
  ],
  "roles": [
    {
      "key": "practitioner",
      "name": "Practitioner",
      "description": "Sees every patient, runs their own treatment plans, quotes and consent forms",
      "permissions": [
        "core.contacts.view",
        "core.contacts.update",
        "core.organizations.view",
        "core.deals.*",
        "core.activities.*",
        "core.tags.view",
        "core.files.*",
        "core.dashboard.view",
        "quotes.quotes.*",
        "documents.documents.*",
        "bookings.bookings.view",
        "invoices.invoices.view"
      ],
      "scopes": {
        "core.contacts": "all",
        "core.organizations": "all",
        "core.deals": "own",
        "core.activities": "own"
      }
    },
    {
      "key": "front_desk",
      "name": "Front desk",
      "description": "Answers enquiries, books consults, collects forms and takes payments",
      "permissions": [
        "core.contacts.*",
        "core.organizations.*",
        "core.leads.*",
        "core.deals.view",
        "core.deals.create",
        "core.deals.update",
        "core.activities.*",
        "core.tags.*",
        "core.files.*",
        "core.dashboard.view",
        "core.saved_views.share",
        "bookings.bookings.*",
        "documents.documents.*",
        "quotes.quotes.view",
        "invoices.invoices.*",
        "invoices.payments.manage",
        "portal.accounts.manage"
      ],
      "scopes": { "*": "all" }
    }
  ],
  "layouts": [
    {
      "entity": "contact",
      "context": "list",
      "columns": [
        "full_name",
        "email",
        "phone",
        "lifecycle_status",
        "cf.payment_type",
        "cf.intake_complete",
        "cf.recall_due",
        "owner"
      ]
    },
    {
      "entity": "deal",
      "context": "list",
      "columns": [
        "title",
        "contact",
        "stage",
        "value",
        "cf.service_line",
        "cf.practitioner",
        "cf.next_appointment",
        "owner"
      ]
    }
  ],
  "dashboard": {
    "name": "Overview",
    "widgets": [
      {
        "key": "occupancy",
        "type": "module:bookings.occupancy",
        "title": "Room and chair use",
        "size": "sm"
      },
      {
        "key": "forms",
        "type": "module:documents.awaiting",
        "title": "Forms awaiting action",
        "size": "sm"
      },
      {
        "key": "pipeline_value",
        "type": "pipeline_value",
        "title": "Treatment plans by stage",
        "size": "lg",
        "params": { "pipeline": "treatment_plans" }
      },
      {
        "key": "appointments",
        "type": "date_window",
        "title": "Appointments in the next 14 days",
        "size": "md",
        "params": { "entity": "deal", "field": "cf.next_appointment", "days": 14, "status": "open" }
      },
      {
        "key": "recalls",
        "type": "date_window",
        "title": "Recalls due in the next 60 days",
        "size": "md",
        "params": { "entity": "contact", "field": "cf.recall_due", "days": 60 }
      },
      {
        "key": "receivables",
        "type": "module:invoices.receivables",
        "title": "Outstanding balances",
        "size": "sm"
      },
      { "key": "tasks_due", "type": "tasks_due", "title": "My tasks due", "size": "md" }
    ]
  },
  "templates": [
    {
      "key": "clinic.plan_follow_up",
      "channel": "email",
      "name": "Plan follow-up",
      "subject": "Any questions about your plan?",
      "body": "<p>Hi {{contact.firstName}},</p><p>Thanks for coming in to see us. We know a new plan is a lot to take in, so we wanted to check whether you have any questions about the steps, timing or costs.</p><p>Reply to this email or call the front desk and we will be happy to talk it through or book your first session.</p>"
    },
    {
      "key": "clinic.recall_reminder",
      "channel": "email",
      "name": "Recall reminder",
      "subject": "Time to book your next check-in",
      "body": "<p>Hi {{contact.firstName}},</p><p>It has been a while since your last visit, and you are now due for a check-in. Reply to this email or call the front desk to choose a time that suits you.</p>"
    }
  ],
