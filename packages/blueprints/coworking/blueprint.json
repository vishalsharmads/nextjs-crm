        "email": "lukas@fable-analytics.test",
        "organization": "fable",
        "lifecycle_status": "Enquirer",
        "custom": { "preferred_plan": "private_office", "id_verified": false }
      },
      {
        "ref": "mei",
        "first_name": "Mei",
        "last_name": "Tanaka",
        "email": "mei.tanaka@example.test",
        "lifecycle_status": "Enquirer",
        "custom": { "preferred_plan": "hot_desk" }
      }
    ],
    "deals": [
