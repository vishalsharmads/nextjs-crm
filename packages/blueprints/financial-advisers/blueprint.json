{
  "$schema": "../schema.json",
  "key": "financial-advisers",
  "name": "Financial advisers and mortgage brokers",
  "version": "1.0.0",
  "description": "Clients, lenders and applications for financial advisers and mortgage brokers, from discovery and fact find to settlement and annual review.",
  "settings": {
    "features": {
      "leads": true
    },
    "general": {
      "currency": "AUD"
    },
    "contacts": {
      "sources": [
        "Referral",
        "Website",
        "Real estate agent",
        "Accountant",
        "Existing client",
        "Seminar",
        "Social",
        "Other"
      ],
      "lifecycleStatuses": [
        "Prospect",
        "Active client",
        "Settled client",
        "Former client",
        "Lender representative"
      ]
    },
    "deals": {
      "lostReasons": [
        "Went direct to lender",
        "Chose another broker",
        "Not approved",
        "Rate not competitive",
        "Deferred purchase",
        "No response"
      ]
    }
  },
  "vocabulary": {
    "contact": {
      "singular": "Client",
      "plural": "Clients"
    },
    "organization": {
      "singular": "Lender",
      "plural": "Lenders"
    },
    "deal": {
      "singular": "Application",
      "plural": "Applications"
    }
  },
  "modules": ["documents", "portal", "quotes", "invoices", "contracts"],
  "custom_field_groups": {
    "contact": [
      {
        "key": "client_profile",
        "label": "Client profile"
      }
    ],
    "deal": [
      {
        "key": "loan",
        "label": "Loan details"
      }
    ]
  },
  "custom_fields": {
    "contact": [
      {
        "key": "client_type",
        "label": "Client type",
        "type": "select",
        "group": "client_profile",
        "filterable": true,
        "show_in_list": true,
        "options": [
          {
            "key": "first_home_buyer",
            "label": "First home buyer"
          },
          {
            "key": "upgrader",
            "label": "Upgrader"
          },
          {
            "key": "refinancer",
            "label": "Refinancer"
          },
          {
            "key": "investor",
            "label": "Investor"
          },
          {
            "key": "smsf_trustee",
            "label": "SMSF trustee"
          },
          {
            "key": "retiree",
            "label": "Pre-retiree or retiree"
          }
        ]
      },
      {
        "key": "fact_find_complete",
        "label": "Fact find complete",
        "type": "boolean",
        "group": "client_profile",
        "filterable": true,
        "show_in_list": true
      },
      {
        "key": "review_due",
        "label": "Annual review due",
        "type": "date",
        "group": "client_profile",
        "filterable": true,
        "show_in_list": true
      }
    ],
    "deal": [
      {
        "key": "application_type",
        "label": "Application type",
        "type": "select",
        "group": "loan",
        "required": true,
        "filterable": true,
        "show_in_list": true,
        "options": [
          {
            "key": "purchase",
            "label": "Home purchase"
          },
          {
            "key": "refinance",
            "label": "Refinance"
          },
          {
            "key": "investment",
            "label": "Investment loan"
          },
          {
            "key": "construction",
            "label": "Construction loan"
          },
          {
            "key": "smsf",
            "label": "SMSF loan"
          },
          {
            "key": "advice",
            "label": "Financial advice"
          }
        ]
      },
      {
        "key": "lvr",
        "label": "LVR (%)",
        "type": "decimal",
        "group": "loan",
        "filterable": true,
        "validation": {
          "min": 0,
          "max": 100,
          "scale": 1
        }
      },
      {
        "key": "interest_rate",
        "label": "Interest rate (%)",
        "type": "decimal",
        "group": "loan",
        "validation": {
          "min": 0,
          "max": 25,
          "scale": 2
        }
      },
      {
        "key": "lodged_on",
        "label": "Lodged on",
        "type": "date",
        "group": "loan",
        "filterable": true
      },
      {
        "key": "expected_settlement",
        "label": "Expected settlement",
        "type": "date",
        "group": "loan",
        "filterable": true,
        "show_in_list": true
      }
    ]
  },
  "pipelines": [
    {
      "key": "applications",
      "name": "Applications",
      "entity": "deal",
      "is_default": true,
      "stages": [
        {
          "key": "discovery",
          "name": "Discovery",
          "probability": 10,
          "rotting_days": 7
        },
        {
          "key": "fact_find",
          "name": "Fact find",
          "probability": 30,
          "rotting_days": 14
        },
        {
          "key": "recommendation",
          "name": "Recommendation",
          "probability": 50,
          "rotting_days": 10
        },
        {
          "key": "lodged",
          "name": "Lodged",
          "probability": 80,
          "rotting_days": 21
        },
        {
          "key": "settled",
          "name": "Settled",
          "probability": 100,
          "is_won": true
        },
        {
          "key": "lost",
          "name": "Lost",
          "probability": 0,
          "is_lost": true
        }
      ]
    }
  ],
  "roles": [
    {
      "key": "adviser",
      "name": "Adviser",
      "description": "Runs their own clients and applications from discovery to settlement and review",
      "permissions": [
        "core.contacts.view",
        "core.contacts.create",
        "core.contacts.update",
        "core.organizations.view",
        "core.leads.*",
        "core.deals.*",
        "core.activities.*",
        "core.tags.view",
        "core.files.*",
        "core.dashboard.view",
        "documents.documents.*",
        "quotes.quotes.*",
        "contracts.contracts.view",
        "contracts.contracts.create",
        "contracts.contracts.update",
        "invoices.invoices.view"
      ],
      "scopes": {
        "core.contacts": "own",
        "core.leads": "own",
        "core.deals": "own",
        "core.activities": "own",
        "core.organizations": "all"
      }
    },
    {
      "key": "client_services",
      "name": "Client services",
      "description": "Chases fact-find documents, books reviews, prepares files for lodgement and handles billing",
      "permissions": [
        "core.contacts.*",
        "core.organizations.*",
        "core.leads.*",
        "core.deals.view",
        "core.deals.update",
        "core.activities.*",
        "core.tags.*",
        "core.files.*",
        "core.dashboard.view",
        "core.saved_views.share",
        "core.audit.view",
        "documents.*",
        "quotes.quotes.view",
        "invoices.*",
        "contracts.contracts.view",
        "portal.accounts.manage"
      ],
      "scopes": {
        "*": "all"
      }
    }
  ],
  "layouts": [
    {
      "entity": "contact",
      "context": "list",
      "columns": [
        "full_name",
        "email",
        "phone",
        "lifecycle_status",
        "cf.client_type",
        "cf.fact_find_complete",
        "cf.review_due",
        "owner"
      ]
    },
    {
      "entity": "deal",
      "context": "list",
      "columns": [
        "title",
        "contact",
        "organization",
        "stage",
        "value",
        "cf.application_type",
        "cf.expected_settlement",
        "owner"
      ]
    }
  ],
  "dashboard": {
    "name": "Overview",
    "widgets": [
      {
        "key": "pipeline_value",
        "type": "pipeline_value",
        "title": "Applications by stage",
        "size": "lg",
        "params": {
          "pipeline": "applications"
        }
      },
      {
        "key": "documents",
        "type": "module:documents.awaiting",
        "title": "Fact-find documents awaiting action",
        "size": "md"
      },
      {
        "key": "settlements",
        "type": "date_window",
        "title": "Settlements in the next 30 days",
        "size": "md",
        "params": {
          "entity": "deal",
          "field": "cf.expected_settlement",
          "days": 30,
          "status": "open"
        }
      },
      {
        "key": "reviews",
        "type": "date_window",
        "title": "Annual reviews due in the next 60 days",
        "size": "md",
        "params": {
          "entity": "contact",
          "field": "cf.review_due",
          "days": 60
        }
      },
      {
        "key": "renewals",
        "type": "module:contracts.renewals",
        "title": "Ongoing advice renewals",
        "size": "sm"
      },
      {
        "key": "receivables",
        "type": "module:invoices.receivables",
        "title": "Outstanding fees",
        "size": "sm"
      },
      {
        "key": "tasks_due",
        "type": "tasks_due",
        "title": "My tasks due",
        "size": "md"
      }
    ]
  },
  "templates": [
    {
      "key": "adviser.fact_find_reminder",
      "channel": "email",
      "name": "Fact-find reminder",
      "subject": "A couple of documents still to come",
      "body": "<p>Hi {{contact.firstName}},</p><p>Thanks for starting your fact find. We are still waiting on a few documents before we can compare options for you. You can upload them securely from your client portal, and the checklist shows exactly what is outstanding.</p><p>If anything is hard to find, reply to this email and we will help.</p>"
    },
    {
      "key": "adviser.annual_review",
      "channel": "email",
      "name": "Annual review invitation",
      "subject": "Time for your annual review",
      "body": "<p>Hi {{contact.firstName}},</p><p>It has been a year since we last reviewed your loan and goals. Rates and circumstances change, so it is worth a short check-in to make sure everything still fits.</p><p>Reply to this email to book a time that suits you.</p>"
    }
  ],
