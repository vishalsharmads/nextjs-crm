{
  "$comment": "AI providers an admin can pick in the assistant settings. Read at run time, never bundled, so provider names stay out of the built app; this file is the one place they may appear (see AGENTS.md). recommended: model ids or id prefixes, best first. tier: free (no card needed), free_tier (free allowance), paid. compatible: starting points for 'Other compatible API' (address filled in, still editable); local ones also need ASSISTANT_PRIVATE_HOSTS. vision: model ids or id fragments that read images (screenshots), matched case-insensitively.",
  "providers": [
    {
      "id": "openai",
      "name": "OpenAI",
      "format": "chat_completions",
      "baseUrl": "https://api.openai.com/v1",
      "keyUrl": "https://platform.openai.com/api-keys",
      "keyPrefix": "sk-",
      "tier": "paid",
      "note": "Strong all-rounder with reliable tool use.",
      "recommended": ["gpt-5-mini", "gpt-5", "gpt-4.1-mini", "gpt-4.1", "gpt-4o-mini"],
      "vision": ["gpt-4o", "gpt-4.1", "gpt-5", "o3", "o4"]
    },
    {
      "id": "anthropic",
      "name": "Anthropic (Claude)",
      "format": "messages",
      "baseUrl": "https://api.anthropic.com",
      "headers": {
        "anthropic-version": "2023-06-01"
      },
      "keyUrl": "https://console.anthropic.com/settings/keys",
      "keyPrefix": "sk-ant-",
      "tier": "paid",
      "note": "Excellent at careful, multi-step work with tools.",
      "recommended": [
        "claude-sonnet-5-5",
        "claude-haiku-5-5",
        "claude-opus-5-5",
        "claude-sonnet",
        "claude-haiku"
      ],
      "vision": ["claude"]
    },
    {
      "id": "gemini",
      "name": "Google Gemini",
      "format": "chat_completions",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "keyUrl": "https://aistudio.google.com/apikey",
      "keyPrefix": "AIza",
      "tier": "free_tier",
      "note": "Generous free allowance; fast Flash models.",
      "recommended": ["gemini-2.5-flash", "gemini-2.5-pro", "gemini-2.0-flash", "gemini-flash", "gemini-pro"],
      "vision": ["gemini"]
    },
    {
      "id": "xai",
      "name": "xAI Grok",
      "format": "chat_completions",
      "baseUrl": "https://api.x.ai/v1",
      "keyUrl": "https://console.x.ai",
      "keyPrefix": "xai-",
      "tier": "paid",
      "note": "Fast models with tool use.",
      "recommended": ["grok-4", "grok-3-mini", "grok-3"],
      "vision": ["grok-4", "vision"]
    },
    {
      "id": "mistral",
      "name": "Mistral AI",
      "format": "chat_completions",
      "baseUrl": "https://api.mistral.ai/v1",
      "keyUrl": "https://console.mistral.ai/api-keys",
      "tier": "free_tier",
      "note": "European provider; free experiment plan.",
      "recommended": ["mistral-large-latest", "mistral-medium-latest", "mistral-small-latest"],
      "vision": ["pixtral", "mistral-medium", "mistral-small"]
    },
    {
      "id": "groq",
      "name": "Groq",
      "format": "chat_completions",
      "baseUrl": "https://api.groq.com/openai/v1",
      "keyUrl": "https://console.groq.com/keys",
      "keyPrefix": "gsk_",
      "tier": "free_tier",
      "note": "Very fast open models; free allowance.",
      "recommended": ["llama-3.3-70b-versatile", "openai/gpt-oss-120b", "llama-3.1-8b-instant"],
      "vision": ["llama-4", "vision"]
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "format": "chat_completions",
      "baseUrl": "https://openrouter.ai/api/v1",
      "keyUrl": "https://openrouter.ai/keys",
      "keyPrefix": "sk-or-",
      "tier": "free",
      "note": "One key for hundreds of models, including free ones (ids ending in :free).",
      "recommended": ["meta-llama/llama-3.3-70b-instruct:free", "deepseek/deepseek-chat", ":free"],
      "vision": ["gpt-4o", "gpt-4.1", "gpt-5", "claude", "gemini", "llama-4", "vision", "vl"]
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "format": "chat_completions",
      "baseUrl": "https://api.deepseek.com/v1",
      "keyUrl": "https://platform.deepseek.com/api_keys",
      "keyPrefix": "sk-",
      "tier": "paid",
      "note": "Low cost per request.",
      "recommended": ["deepseek-chat"],
      "vision": []
    },
    {
      "id": "cerebras",
      "name": "Cerebras",
      "format": "chat_completions",
      "baseUrl": "https://api.cerebras.ai/v1",
      "keyUrl": "https://cloud.cerebras.ai",
      "keyPrefix": "csk-",
      "tier": "free_tier",
      "note": "Very fast open models; free allowance.",
      "recommended": ["gpt-oss-120b", "llama-3.3-70b", "qwen-3"],
      "vision": ["llama-4"]
    }
  ],
  "compatible": [
    {
      "name": "Ollama",
      "baseUrl": "http://localhost:11434/v1",
      "local": true,
      "note": "Open models on your own machine; no key needed."
    },
    {
      "name": "LM Studio",
      "baseUrl": "http://localhost:1234/v1",
      "local": true,
      "note": "Desktop app serving local models; no key needed."
    },
    {
      "name": "vLLM",
      "baseUrl": "http://localhost:8000/v1",
      "local": true,
      "note": "High-throughput model server you run yourself."
    },
    {
      "name": "LocalAI",
      "baseUrl": "http://localhost:8080/v1",
      "local": true,
      "note": "Self-hosted drop-in for the common API."
    },
    {
      "name": "Together AI",
      "baseUrl": "https://api.together.xyz/v1",
      "local": false,
      "note": "Hosted open models; needs a key."
    },
    {
      "name": "Fireworks AI",
      "baseUrl": "https://api.fireworks.ai/inference/v1",
      "local": false,
      "note": "Hosted open models; needs a key."
    }
  ]
}
