{
  "name": "@app/root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "modules/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c auto \"npm:dev -w @app/api\" \"npm:dev -w @app/web\"",
    "build": "npm run build -w @app/api && npm run build -w @app/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @app/web",
    "db:migrate": "npm run cli -w @app/api -- db:migrate",
    "db:rollback": "npm run cli -w @app/api -- db:rollback",
    "db:seed": "npm run cli -w @app/api -- db:seed",
    "install:instance": "npm run cli -w @app/api -- install",
    "crm:install": "npm run install:instance --",
    "blueprint:apply": "npm run cli -w @app/api -- blueprint:apply",
    "crm:export-blueprint": "npm run cli -w @app/api -- blueprint:export",
    "doctor": "npm run cli -w @app/api -- doctor",
    "check:brand": "node scripts/check-brand-strings.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
