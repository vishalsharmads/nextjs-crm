# Copy to .env and fill in. Every variable is documented in docs/env-reference.md.

NODE_ENV=development
PORT=4000
# Public URL of the web app (used in emails and links)
APP_URL=http://localhost:5173
# Only needed when web and API are on different origins (not recommended)
CORS_ORIGINS=
# Number of reverse proxies in front of the API (nginx = 1)
TRUST_PROXY=0

DATABASE_URL=mysql://root@127.0.0.1:3306/crm_dev
DATABASE_URL_TEST=mysql://root@127.0.0.1:3306/crm_test

# Secrets: production refuses to start with defaults. Generate with: openssl rand -hex 32
JWT_SECRET=
CSRF_SECRET=
FILE_URL_SECRET=
# 64 hex chars (32 bytes): openssl rand -hex 32
ENCRYPTION_KEY=
# Defaults to true in production
COOKIE_SECURE=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14

# Mail (Mailpit in development: http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@localhost

STORAGE_DIR=./storage
UPLOAD_MAX_MB=20

# Phase 2 (jobs). Leave empty to run jobs in-process.
REDIS_URL=
LOG_LEVEL=info

# Optional: where blueprint folders live in packaged deployments
BLUEPRINTS_DIR=
