# One server block per client instance. Web and API share an origin, so auth cookies stay first-party.

# Access log without query strings: search terms and filters often contain names and emails.
# (Site files are included inside the http block, where log_format belongs. Define it once.)
# Rate limits for sign-in and public endpoints (the API also limits per address).
limit_req_zone $binary_remote_addr zone=crm_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=crm_api:10m rate=20r/s;

log_format crm_minimal '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                       '$status $body_bytes_sent "$http_user_agent"';

server {
    listen 443 ssl http2;
    server_name crm.client.example;

    ssl_certificate     /etc/letsencrypt/live/crm.client.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/crm.client.example/privkey.pem;

    access_log /var/log/nginx/crm.client.example.access.log crm_minimal;

    root /srv/crm/client/apps/web/dist;
    index index.html;
    client_max_body_size 25m;

    # Copy deploy/nginx-security-headers.conf to /etc/nginx/snippets/crm-security-headers.conf.
    include snippets/crm-security-headers.conf;

    location /api/auth/ {
        limit_req zone=crm_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=crm_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # OAuth discovery for AI clients (MCP) is served by the API at the site root.
    location /.well-known/oauth- {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed assets are immutable; index.html must always revalidate (branding is runtime anyway).
    location /assets/ {
        expires 1y;
        include snippets/crm-security-headers.conf;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri /index.html;
        include snippets/crm-security-headers.conf;
        add_header Cache-Control "no-cache";
    }
}

server {
    listen 80;
    server_name crm.client.example;
    return 301 https://$host$request_uri;
}
