---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';
import { industries } from '../data/industries';
import { demoLinks, site } from '../data/site';
import { breadcrumbSchema } from '../data/schema';
---

<Base
  title="Book a Bespoq demo | See the CRM set up for your industry"
  description="Book a 30-minute demo: we set Bespoq up in your industry’s words while you watch. Or explore a live demo for your industry."
  schema={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Book a demo', path: '/demo' },
    ])
  ]}
>
  <PageHero
    title="See Bespoq fitted to your business"
    lede="In 30 minutes we set Bespoq up in your industry’s words while you watch, walk through your workflow, and answer every question about price, hosting and setup."
  />
  <section class="section">
    <div class="wrap layout" id="book">
      <div class="intro">
        <h2 class="h2">Book your demo</h2>
        <ol class="next">
          <li>We email within one business day to find a time.</li>
          <li>On the call, we tailor a demo to your industry live.</li>
          <li>You get a fixed written quote afterwards.</li>
        </ol>
      </div>
      <LeadForm source="demo" />
    </div>
  </section>
  <section class="section" id="live">
    <div class="wrap">
      <div class="head">
        <h2 class="h2">Try a live demo</h2>
        <p class="lede muted">
          Each demo is a real Bespoq instance with sample data, set up for one industry. Sign in with one click as any role.
          The industry marked live is open now; book any other and we set it up for your call.
        </p>
      </div>
      <ul class="demos">
        {
          industries.map((i) => {
            const href = demoLinks[i.slug];
            return (
              <li data-demo={i.slug}>
                <span class="name">
                  {i.name}
                  <span class="live" hidden={!href}>Live now</span>
                </span>
                <a
                  class="btn btn-ghost sm"
                  href={href ?? '#book'}
                  data-demo-link={i.slug}
                  data-live-href={site.signInUrl}
                  data-live-label="Open live demo"
                >
                  {href ? 'Open live demo' : 'Book this demo'}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
  }
  .intro {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .next {
    margin: 0;
    padding-inline-start: 22px;
    display: grid;
    gap: 10px;
    font-size: 18px;
  }
  .head {
    display: grid;
    gap: 14px;
    max-width: 760px;
    margin-bottom: 32px;
  }
  .live {
    margin-inline-start: 10px;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--tape);
    color: var(--tape-ink);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
  }
  .live[hidden] {
    display: none;
  }
  .demos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .demos li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 16px 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .name {
    font-weight: 600;
  }
  .btn.sm {
    white-space: nowrap;
    min-height: 40px;
    padding: 0 16px;
    font-size: 14.5px;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .demos {
      grid-template-columns: 1fr;
    }
  }
</style>
