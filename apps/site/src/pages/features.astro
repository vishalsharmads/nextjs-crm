---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Compare from '../components/Compare.astro';
import CtaBand from '../components/CtaBand.astro';
import Shots from '../components/Shots.astro';
import { features } from '../data/site';
import { breadcrumbSchema, softwareSchema } from '../data/schema';

/** Real product screens, taken from the demo workspace (a fictional software company). */
const screens: Record<string, { src: string; alt: string; label: string }[]> = {
  ai: [
    {
      src: '/product/assistant-panel.webp',
      label: 'On a record',
      alt: 'An opportunity page with the assistant open beside it, offering to summarise the opportunity, suggest next steps, show recent changes or draft a follow-up email',
    },
    {
      src: '/product/assistant-tasks.webp',
      label: 'On any page',
      alt: 'The task list with the assistant panel open, suggesting questions such as which opportunities close this month',
    },
  ],
  pipelines: [
    {
      src: '/product/deals.webp',
      label: 'Board',
      alt: 'An opportunities board with stages from Discovery to Proposal, each card showing the account, value and owner',
    },
  ],
  tasks: [
    {
      src: '/product/tasks.webp',
      label: 'My work',
      alt: 'The task list grouped into Overdue, Today and Upcoming, with priorities and checklist progress on each task',
    },
    {
      src: '/product/task-board.webp',
      label: 'Board',
      alt: 'A task board with To do, In progress, Waiting and Done columns',
    },
    {
      src: '/product/task-page.webp',
      label: 'Task page',
      alt: 'A task page with status, due date, reminder, repeat and priority, a checklist two of four done, and a comment',
    },
  ],
};

/** What each module does, in specifics a buyer can check off. */
const detail: Record<string, string[]> = {
  ai: [
    'Questions in plain words, answered from your records, with reports and charts from the real numbers',
    'Summaries of a record’s history and drafted notes and emails, on the page you are looking at',
    'Changes proposed in plain words and made only after you press Confirm',
    'Workspace setup from a description of your business, for admins',
    'Any AI app that supports MCP can connect, with each person’s own sign-in and permissions',
    'Your choice of AI provider, or a model server you run yourself; every action in the audit log',
  ],
  pipelines: [
    'Rename people, organizations and deals to your industry’s words, everywhere',
    'Your own pipeline stages, with Kanban and list views',
    'Custom fields, layouts and saved views per team',
    'Own, team or everyone access, set per role',
  ],
  tasks: [
    'My work: overdue, today, upcoming, with quick add, filters and keyboard shortcuts',
    'Checklists, repeating tasks and reminders, plus a morning email of what is due',
    'Comments with @mentions on every task',
    'Optional statuses such as To do, In progress and Waiting, on a drag-and-drop board',
    'A calendar where you drag to reschedule and select a time to create',
  ],
  'quotes-invoices': [
    'A product and service price list with tax rates',
    'Quotes clients accept online with a typed signature',
    'One-click conversion from an accepted quote to an invoice',
    'Partial payments, overdue alerts and a receivables widget',
  ],
  'client-portal': [
    'Password-free sign-in with a single-use email link',
    'Quotes, invoices, contracts and shared documents in one place',
    'Online quote acceptance and document signing',
    'File uploads and support requests from clients',
  ],
  bookings: [
    'Rooms, desks, crews, chairs and equipment as bookable resources',
    'Opening hours and capacity enforced',
    'A day board in your business’s time zone',
    'Double bookings refused, even when two people click at once',
  ],
  documents: [
    'Templates with placeholders filled from the record',
    'Drafts you edit, then share to the client portal',
    'Signatures with name, time and a fingerprint of the content',
    'Document checklists clients complete by uploading files',
  ],
  support: [
    'Priorities with first-response and resolution targets',
    'Internal notes and client-visible replies',
    'Requests raised from the client portal',
    'Overdue tickets flagged on the dashboard',
  ],
  automations: [
    'When something happens, filter it, then act: update, notify, email, tag',
    'Signed webhooks with retries for your other systems',
    'A full REST API with scoped API keys',
    'Web forms that create leads straight from your website',
  ],
  security: [
    'Your own instance and database, hosted where you choose',
    'Two-factor sign-in and enforced admin 2FA',
    'An append-only audit log nobody can edit',
    'Full export of your data at any time',
  ],
};
---

<Base
  title="CRM features: AI assistant, quotes, invoices, client portal | Bespoq"
  description="Everything in Bespoq: an AI assistant that asks before it acts, pipelines in your words, tasks, quotes to payments, a client portal, bookings, documents and e-signatures, a support desk, automations and data ownership."
  schema={[
    softwareSchema({ description: 'A configurable CRM with an AI assistant, tasks, quotes, invoices, client portal, bookings, documents, support desk and automations.' }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Features', path: '/features' },
    ]),
  ]}
>
  <PageHero
    title="Everything your service business runs on"
    lede="Bespoq brings your clients, the work you win, the money you are owed and the documents you exchange into one system that uses your industry’s words. Switch modules on as you need them."
  />
  {
    features.map((f) => (
      <section class="section feature" id={f.slug} aria-labelledby={`${f.slug}-title`}>
        <div class="wrap layout">
          <div class="text">
            <h2 class="h2" id={`${f.slug}-title`}>
              {f.name}
            </h2>
            <p class="lede muted">{f.body}</p>
          </div>
          <ul class="points">
            {detail[f.slug]!.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
        {screens[f.slug] && (
          <div class="wrap screens">
            <Shots shots={screens[f.slug]!} />
          </div>
        )}
      </section>
    ))
  }
  <Compare />
  <CtaBand />
</Base>

<style>
  .feature {
    scroll-margin-top: 72px;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .screens {
    margin-top: clamp(40px, 6vw, 72px);
  }
  .text {
    display: grid;
    gap: 18px;
  }
  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .points li {
    position: relative;
    padding: 16px 0 16px 34px;
    border-top: 2px dashed var(--border-strong);
    font-size: 18px;
  }
  .points li:last-child {
    border-bottom: 2px dashed var(--border-strong);
  }
  /* a tailor's tick: a short stitched check */
  .points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 4px;
    top: 24px;
    width: 14px;
    height: 7px;
    border-inline-start: 2px solid var(--tape);
    border-bottom: 2px solid var(--tape);
    transform: rotate(-45deg);
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
