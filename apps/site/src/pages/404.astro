---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Page not found | Bespoq" description="This page does not exist.">
  <PageHero title="This page doesn’t fit" lede="It may have moved, or the link has a typo. Try the home page or pick your industry.">
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <a class="btn btn-tape" href="/">Go to the home page</a>
      <a class="btn btn-ghost" href="/industries">See industries</a>
    </div>
  </PageHero>
</Base>
