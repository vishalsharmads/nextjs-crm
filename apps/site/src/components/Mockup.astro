---
/**
 * A faithful miniature of the product's pipeline board, labelled in one industry's words.
 * Text nodes carry data-k keys so the hero tape can re-tailor them in place.
 */
import type { Industry } from '../data/industries';
interface Props {
  industry: Industry;
  id?: string;
}
const { industry: i, id } = Astro.props;
const owners = ['AO', 'LB', 'MT', 'JK', 'SR'];
---

<figure class="mock" id={id} aria-label={`The ${i.vocab.deals.toLowerCase()} board in Bespoq, set up for ${i.name.toLowerCase()}`}>
  <div class="frame">
    <aside class="side" aria-hidden="true">
      <span class="brand">Your brand</span>
      <span class="nav-item">Home</span>
      <span class="nav-item" data-k="contacts">{i.vocab.contacts}</span>
      <span class="nav-item on" data-k="deals">{i.vocab.deals}</span>
      <span class="nav-item">Tasks</span>
      <span class="nav-item">Invoices</span>
    </aside>
    <div class="main">
      <div class="top">
        <span class="title" data-k="deals">{i.vocab.deals}</span>
        <span class="new">New <span data-k="deal-lower">{i.vocab.deal.toLowerCase()}</span></span>
      </div>
      <div class="board">
        {
          i.stages.map((stage, s) => (
            <div class="col">
              <div class="col-head">
                <span data-k={`stage-${s}`}>{stage}</span>
              </div>
              {i.cards
                .filter((c) => c.stage === s)
                .map((c) => (
                  <div class="card">
                    <span class="card-name" data-k={`card-${s}-name`}>
                      {c.name}
                    </span>
                    <span class="card-detail" data-k={`card-${s}-detail`}>
                      {c.detail}
                    </span>
                    <span class="avatar" aria-hidden="true">{owners[s]}</span>
                  </div>
                ))}
              <div class="ghost" aria-hidden="true" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</figure>

<style>
  .mock {
    margin: 0;
    width: 100%;
  }
  .frame {
    display: grid;
    grid-template-columns: 112px 1fr;
    background: #fbfcfa;
    color: var(--ink);
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.5) inset,
      0 30px 60px -20px rgb(4 20 14 / 0.55),
      0 0 0 1px rgb(4 20 14 / 0.2);
    font-size: 12.5px;
    line-height: 1.3;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 10px;
    background: #eef2ed;
    border-inline-end: 1px solid var(--line);
  }
  .brand {
    font-weight: 700;
    font-size: 12px;
    padding: 4px 8px 12px;
    color: var(--mat);
  }
  .nav-item {
    padding: 6px 8px;
    border-radius: 6px;
    color: var(--steel);
  }
  .nav-item.on {
    background: #fff;
    color: var(--ink);
    font-weight: 600;
    box-shadow: 0 0 0 1px var(--line);
  }
  .main {
    padding: 14px 16px 18px;
    min-width: 0;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 17px;
    letter-spacing: -0.02em;
  }
  .new {
    background: var(--mat);
    color: var(--chalk);
    padding: 6px 10px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 11.5px;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
  }
  .col {
    background: #f1f4f0;
    border-radius: 8px;
    padding: 6px;
    display: grid;
    gap: 6px;
    align-content: start;
    min-height: 170px;
  }
  .col-head {
    font-weight: 600;
    color: var(--steel);
    font-size: 11.5px;
    line-height: 1.25;
    padding: 2px 2px 4px;
    min-height: 2.6em;
  }
  .card {
    position: relative;
    display: grid;
    gap: 2px;
    background: #fff;
    border-radius: 6px;
    padding: 8px 8px 22px;
    box-shadow: 0 0 0 1px var(--line);
  }
  .card-name {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .card-detail {
    color: var(--steel);
    font-size: 11.5px;
  }
  .avatar {
    position: absolute;
    inset-inline-end: 6px;
    bottom: 5px;
    font-size: 9px;
    font-weight: 700;
    color: var(--mat);
    background: #dbe7e0;
    border-radius: 999px;
    padding: 2px 4px;
  }
  .ghost {
    height: 34px;
    border-radius: 6px;
    border: 1.5px dashed rgb(18 32 27 / 0.12);
  }
  @media (max-width: 720px) {
    .frame {
      grid-template-columns: 1fr;
    }
    .side {
      display: none;
    }
    .board {
      grid-template-columns: repeat(5, 132px);
      overflow-x: auto;
    }
  }
</style>
