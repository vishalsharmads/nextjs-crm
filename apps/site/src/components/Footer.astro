---
import Logo from './Logo.astro';
import { industries } from '../data/industries';
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer on-mat">
  <div class="wrap grid">
    <div class="brand">
      <Logo tone="light" />
      <p class="muted">The CRM, tailored to your industry. For service businesses in the United States and Australia.</p>
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <nav aria-label="Industries">
      <h2>Industries</h2>
      <ul>
        {industries.map((i) => <li><a href={`/industries/${i.slug}`}>{i.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Product">
      <h2>Product</h2>
      <ul>
        <li><a href="/features">Features</a></li>
        <li><a href="/white-label">For agencies</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/roi-calculator">Admin cost calculator</a></li>
        <li><a href="/demo">Book a demo</a></li>
      </ul>
    </nav>
    <nav aria-label="Company">
      <h2>Company</h2>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/resources">Resources</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap base">
    <p>© {year} Bespoq. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 80px 32px;
    position: relative;
  }
  /* A stitched seam where the footer meets a green section above it. */
  .footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background-image: linear-gradient(90deg, rgb(242 194 48 / 0.7) 60%, transparent 0);
    background-size: 14px 2px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 40px;
  }
  .brand {
    display: grid;
    gap: 16px;
    align-content: start;
    max-width: 34ch;
  }
  h2 {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--tape);
    margin-bottom: 12px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  ul a {
    text-decoration: none;
    color: rgb(243 246 241 / 0.82);
    font-size: 15.5px;
    transition: color 160ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    ul a:hover {
      color: var(--chalk);
    }
  }
  .base {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line-on-mat);
    font-size: 14px;
    color: rgb(243 246 241 / 0.6);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
